<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bíblia Bilíngue Pro</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --bg: #0f172a; --card: #1e293b; --border: #334155;
    --text: #e2e8f0; --muted: #94a3b8; --accent: #f59e0b; --fs: 17px;
  }
  [data-theme="light"] {
    --bg: #f8fafc; --card: #ffffff; --border: #e2e8f0;
    --text: #0f172a; --muted: #64748b; --accent: #d97706;
  }
  body { font-family: system-ui, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; line-height: 1.5; overflow-x: hidden; transition: background 0.3s, color 0.3s; }
  
  /* CABEÇALHO */
  header { position: sticky; top: 0; z-index: 30; background: var(--bg); opacity: 0.98; border-bottom: 1px solid var(--border); padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .menu-btn { background: none; border: none; color: var(--text); font-size: 1.4rem; cursor: pointer; padding: 0.2rem 0.5rem; }
  .header-title { flex: 1; min-width: 0; }
  header h1 { font-size: 1rem; color: var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .loc { font-size: 0.7rem; color: var(--muted); display: block; }
  .icon-btn { background: none; border: none; color: var(--muted); font-size: 1.2rem; padding: 0.4rem; cursor: pointer; border-radius: 8px; }
  
  /* MENU LATERAL (SIDEBAR) */
  .overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 40; opacity: 0; pointer-events: none; transition: opacity 0.3s; }
  .overlay.on { opacity: 1; pointer-events: auto; }
  .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: 320px; background: var(--card); border-right: 1px solid var(--border); z-index: 50; transform: translateX(-100%); transition: transform 0.3s ease; display: flex; flex-direction: column; }
  .sidebar.on { transform: translateX(0); }
  .sidebar-header { padding: 1rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .close-btn { background: none; border: none; color: var(--muted); font-size: 1.4rem; cursor: pointer; }
  .sidebar-tabs { display: flex; border-bottom: 1px solid var(--border); }
  .tab-btn { flex: 1; background: none; border: none; color: var(--muted); padding: 0.8rem 0.2rem; cursor: pointer; font-weight: bold; border-bottom: 2px solid transparent; font-size: 0.85rem;}
  .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
  .sidebar-content { flex: 1; overflow-y: auto; padding: 0.5rem; }
  .search-box { padding: 0.5rem 1rem; }
  .search-box input { width: 100%; padding: 0.6rem; border-radius: 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); outline: none; }
  
  /* LISTA DE LIVROS E FAVORITOS */
  .testament-title { font-size: 0.75rem; font-weight: bold; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; padding: 1rem 0.5rem 0.5rem; border-bottom: 1px solid var(--border); margin-bottom: 0.5rem; }
  .book-btn, .fav-btn-list { width: 100%; text-align: left; background: none; border: none; color: var(--text); padding: 0.7rem 1rem; border-radius: 8px; font-size: 0.95rem; cursor: pointer; font-family: inherit; display: block;}
  .book-btn:hover, .fav-btn-list:hover { background: var(--bg); }
  .book-btn.active { background: rgba(245,158,11,0.15); color: var(--accent); font-weight: bold; }
  .fav-btn-list { border-bottom: 1px solid var(--border); border-radius: 0; padding: 0.8rem; font-size: 0.85rem;}
  .fav-ref { color: var(--accent); font-weight: bold; display: block; margin-bottom: 0.2rem; }
  .search-result { padding: 0.8rem; border-bottom: 1px solid var(--border); font-size: 0.85rem; cursor: pointer; }
  .search-result:hover { background: var(--bg); }
  .search-ref { color: var(--accent); font-weight: bold; display: block; margin-bottom: 0.2rem; }

  /* ÁREA PRINCIPAL */
  main { max-width: 800px; margin: 0 auto; padding: 1rem 1rem 6rem; }
  .top-controls { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 0.5rem; }
  .chapter-title h2 { font-size: 1.5rem; }
  .chapter-title .sub { font-size: 0.8rem; color: var(--muted); }
  
  .nav-group { display: flex; gap: 0.3rem; align-items: center; background: var(--card); padding: 0.2rem; border-radius: 10px; border: 1px solid var(--border);}
  .nav-arrow { background: none; border: none; color: var(--text); font-size: 1rem; cursor: pointer; padding: 0.3rem 0.6rem; border-radius: 6px;}
  .nav-arrow:active { background: var(--bg); }
  .nav-arrow:disabled { opacity: 0.3; }
  .chapter-select { background: transparent; color: var(--text); border: none; padding: 0.3rem; font-weight: bold; outline: none; cursor: pointer; }
  .chapter-select option { background: var(--card); color: var(--text); }

  .dl-btn { background: rgba(245,158,11,0.1); color: var(--accent); border: 1px solid var(--accent); padding: 0.4rem 0.6rem; border-radius: 8px; font-size: 0.75rem; cursor: pointer; white-space: nowrap; }
  .dl-btn:disabled { opacity: 0.5; }

  /* VERSÍCULOS */
  .verse { padding: 1rem; margin-bottom: 0.4rem; border-radius: 10px; border-left: 3px solid transparent; cursor: pointer; transition: all 0.2s; position: relative; }
  .verse:hover { background: var(--card); }
  .verse.active { background: rgba(245,158,11,0.15); border-left-color: var(--accent); }
  .verse-num { display: inline-block; background: var(--card); color: var(--accent); font-size: 0.7rem; font-weight: bold; padding: 0.15rem 0.5rem; border-radius: 6px; margin-right: 0.5rem; }
  .verse.active .verse-num { background: var(--accent); color: var(--bg); }
  .verse-en, .verse-pt { font-family: Georgia, serif; font-size: var(--fs); line-height: 1.7; margin-bottom: 0.4rem; }
  .verse-en { font-style: italic; color: var(--muted); }
  .verse-pt { color: var(--text); }
  .lang-tag { display: inline-block; font-size: 0.6rem; font-weight: bold; color: var(--muted); font-family: system-ui, sans-serif; margin-right: 0.4rem; font-style: normal; }
  .fav-btn { position: absolute; top: 1rem; right: 1rem; background: none; border: none; font-size: 1.2rem; cursor: pointer; opacity: 0.3; transition: opacity 0.2s; }
  .verse:hover .fav-btn { opacity: 1; }
  .fav-btn.is-fav { opacity: 1; color: #fbbf24; }

  /* BARRA DE ÁUDIO */
  .audio-bar { position: fixed; bottom: 0; left: 0; right: 0; background: var(--card); border-top: 1px solid var(--border); padding: 0.75rem 1rem; display: none; align-items: center; gap: 0.75rem; z-index: 25; box-shadow: 0 -4px 10px rgba(0,0,0,0.1); }
  .audio-bar.on { display: flex; }
  .audio-bar .info { flex: 1; }
  .audio-bar .lbl { font-size: 0.7rem; color: var(--muted); text-transform: uppercase; }
  .audio-bar .curr { font-size: 0.9rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .play-btn { width: 42px; height: 42px; border-radius: 50%; border: none; background: var(--accent); color: #fff; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .play-btn.secondary { background: var(--bg); color: var(--muted); border: 1px solid var(--border); }

  /* MODAIS, TOAST E LOADING */
  .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 60; display: none; align-items: center; justify-content: center; padding: 1rem; }
  .modal.on { display: flex; }
  .modal-box { background: var(--card); border: 1px solid var(--border); border-radius: 14px; width: 100%; max-width: 420px; padding: 1.2rem; max-height: 85vh; overflow-y: auto; }
  .modal-header { display: flex; justify-content: space-between; margin-bottom: 1rem; }
  .settings-group { margin-bottom: 1rem; }
  .settings-group label { display: block; font-size: 0.85rem; margin-bottom: 0.4rem; font-weight: 500; }
  .settings-group select { width: 100%; background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 0.6rem; border-radius: 8px; }
  .toast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%) translateY(30px); background: var(--card); border: 1px solid var(--border); color: var(--text); padding: 0.6rem 1rem; border-radius: 8px; font-size: 0.85rem; opacity: 0; transition: all 0.3s; z-index: 70; pointer-events: none; text-align: center; width: 80%; max-width: 300px;}
  .toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }
  .loading { position: fixed; inset: 0; background: var(--bg); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 1rem; z-index: 100; }
  .spinner { width: 40px; height: 40px; border: 3px solid var(--card); border-top-color: var(--accent); border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .progress-bar { width: 100%; background: var(--border); height: 8px; border-radius: 4px; margin-top: 1rem; overflow: hidden; }
  .progress-fill { height: 100%; background: var(--accent); width: 0%; transition: width 0.2s; }
  
  @media (max-width: 600px) {
    .top-controls { flex-direction: column; align-items: flex-start; }
    .dl-btn { flex: 1; text-align: center; }
    .controls-row { display: flex; width: 100%; gap: 0.5rem; }
  }
</style>
</head>
<body>

<div class="loading" id="loading">
  <div class="spinner"></div>
  <p>Preparando Banco de Dados...</p>
</div>

<header>
  <button class="menu-btn" onclick="toggleMenu()">☰</button>
