    <button class="dl-btn" id="dlBookBtn" onclick="downloadWholeBook()">⬇️ Baixar Livro Inteiro</button>
  </div>

  <div id="verses"></div>
</main>

<div class="audio-bar" id="audioBar">
  <button class="play-btn secondary" onclick="stopAudio()">✕</button>
  <div class="info">
    <div class="lbl">Narração</div>
    <div class="curr" id="audioInfo">—</div>
  </div>
  <button class="play-btn" id="pauseBtn" onclick="togglePlay()">⏸</button>
</div>

<div class="modal" id="settingsModal">
  <div class="modal-box">
    <div class="modal-header">
      <h3>⚙️ Configurações</h3>
      <button class="close-btn" onclick="closeSettings()">✕</button>
    </div>
    <div class="settings-group">
      <label>Modo de Áudio</label>
      <select id="audioMode">
        <option value="both">Bilíngue (EN + PT)</option>
        <option value="en">Apenas Inglês</option>
        <option value="pt">Apenas Português</option>
      </select>
    </div>
    <div class="settings-group">
      <label>Voz em Inglês</label>
      <select id="voiceEN"><option value="">Automática</option></select>
    </div>
    <div class="settings-group">
      <label>Voz em Português</label>
      <select id="voicePT"><option value="">Automática</option></select>
    </div>
    <div class="settings-group">
      <label>Velocidade (<span id="rateVal">1.0</span>x)</label>
      <input type="range" id="rateInput" min="0.6" max="1.8" step="0.1" value="1.0" style="width:100%">
    </div>
    <div class="settings-group">
      <label>Tamanho do Texto (<span id="fontVal">17</span>px)</label>
      <input type="range" id="fontInput" min="14" max="24" step="1" value="17" style="width:100%">
    </div>
    
    <div style="margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 1rem;">
      <button class="dl-btn" style="background: rgba(239,68,68,0.1); color: #ef4444; border-color: #ef4444; width: 100%; padding: 0.8rem; font-weight: bold;" onclick="clearAllDownloads()">🗑️ Limpar Todos os Downloads</button>
    </div>
  </div>
</div>

<div class="modal" id="downloadModal">
  <div class="modal-box" style="text-align:center;">
    <h3>Baixando Livro...</h3>
    <p id="dlProgressText" style="margin-top:1rem; font-size:0.9rem; color:var(--muted);">Iniciando...</p>
    <div class="progress-bar"><div class="progress-fill" id="dlProgressFill"></div></div>
    <p style="font-size:0.75rem; color:var(--muted); margin-top:1rem;">Por favor, mantenha o app aberto. (Pausa de 1.5s entre capítulos).</p>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/sql-asm.js"></script>
