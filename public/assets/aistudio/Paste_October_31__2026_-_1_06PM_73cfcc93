function initIDB() {
  return new Promise(function(resolve) {
    var req = indexedDB.open("BibliaDB", 1);
    req.onupgradeneeded = function(e) { e.target.result.createObjectStore("sqlite"); };
    req.onsuccess = function(e) { idbStore = e.target.result; resolve(); };
  });
}
function saveDB() {
  if (!idbStore) return;
  var tx = idbStore.transaction("sqlite", "readwrite");
  tx.objectStore("sqlite").put(db.export(), "dbfile");
}
function loadDB() {
  return new Promise(function(resolve) {
    if (!idbStore) { resolve(null); return; }
    var tx = idbStore.transaction("sqlite", "readonly");
    var req = tx.objectStore("sqlite").get("dbfile");
    req.onsuccess = function() { resolve(req.result); };
    req.onerror = function() { resolve(null); };
  });
}

async function initApp() {
  try {
    SQL = await initSqlJs({ locateFile: function(f) { return 'https://cdnjs.cloudflare.com/ajax/libs/sql.js/1.10.2/' + f; } });
    await initIDB();
    var savedData = await loadDB();
    
    if (savedData) {
      db = new SQL.Database(new Uint8Array(savedData));
    } else {
      db = new SQL.Database();
      db.run("CREATE TABLE livros (id INTEGER PRIMARY KEY, nome_pt TEXT, nome_en TEXT, caps INTEGER)");
      db.run("CREATE TABLE versiculos (livro_id INTEGER, capitulo INTEGER, numero INTEGER, texto_en TEXT, texto_pt TEXT)");
      db.run("CREATE TABLE progresso (id INTEGER PRIMARY KEY, livro_id INTEGER, capitulo INTEGER, versiculo INTEGER)");
      db.run("CREATE TABLE favoritos (id INTEGER PRIMARY KEY AUTOINCREMENT, livro_id INTEGER, capitulo INTEGER, versiculo INTEGER)");
      
      var allBooks = OLD_TESTAMENT.concat(NEW_TESTAMENT);
      var stmt = db.prepare("INSERT INTO livros VALUES (?, ?, ?, ?)");
      allBooks.forEach(function(b) { stmt.run([b.id, b.pt, b.en, b.caps]); });
      stmt.free();
      db.run("INSERT INTO progresso VALUES (1, 43, 1, 1)");
      saveDB();
    }

    loadSettings();
    loadVoices();
    renderBooksList();
    restoreReadingProgress();
    document.getElementById('loading').style.display = 'none';
  } catch (err) {
    document.getElementById('loading').innerHTML = '<p style="color:red;text-align:center;padding:2rem;">Erro: ' + err.message + '</p>';
  }
}

function toggleMenu() {
  document.getElementById('sidebar').classList.toggle('on');
  document.getElementById('overlay').classList.toggle('on');
}
function switchTab(tab) {
  document.getElementById('viewBooks').style.display = tab === 'books' ? 'block' : 'none';
  document.getElementById('viewSearch').style.display = tab === 'search' ? 'block' : 'none';
  document.getElementById('viewFavs').style.display = tab === 'favs' ? 'block' : 'none';
  document.getElementById('tabBooks').className = 'tab-btn' + (tab === 'books' ? ' active' : '');
  document.getElementById('tabSearch').className = 'tab-btn' + (tab === 'search' ? ' active' : '');
  document.getElementById('tabFavs').className = 'tab-btn' + (tab === 'favs' ? ' active' : '');
  if(tab === 'favs') renderFavorites();
}

function renderBooksList() {
  var container = document.getElementById('booksList');
  container.innerHTML = '';
  
  var atTitle = document.createElement('div');
  atTitle.className = 'testament-title';
  atTitle.innerText = 'Antigo Testamento';
  container.appendChild(atTitle);

  OLD_TESTAMENT.forEach(function(b) {
    var btn = document.createElement('button');
    btn.className = 'book-btn' + (currentBook && currentBook.id === b.id ? ' active' : '');
    btn.innerHTML = '<span>' + b.pt + '</span>';
    btn.onclick = function() { loadChapter(b.id, 1); toggleMenu(); };
    container.appendChild(btn);
  });

  var ntTitle = document.createElement('div');
  ntTitle.className = 'testament-title';
  ntTitle.innerText = 'Novo Testamento';
  container.appendChild(ntTitle);

  NEW_TESTAMENT.forEach(function(b) {
    var btn = document.createElement('button');
    btn.className = 'book-btn' + (currentBook && currentBook.id === b.id ? ' active' : '');
    btn.innerHTML = '<span>' + b.pt + '</span>';
    btn.onclick = function() { loadChapter(b.id, 1); toggleMenu(); };
    container.appendChild(btn);
  });
}

function renderFavorites() {
  var container = document.getElementById('favsList');
  container.innerHTML = '<div style="padding: 1rem; text-align: center; color: var(--muted);">Carregando...</div>';
  
  var res = db.exec("SELECT f.livro_id, l.nome_pt, f.capitulo, f.versiculo FROM favoritos f JOIN livros l ON f.livro_id = l.id ORDER BY f.id DESC");
  container.innerHTML = '';
  
  if (res[0] && res[0].values.length > 0) {
    res[0].values.forEach(function(row) {
      var btn = document.createElement('button');
      btn.className = 'fav-btn-list';
      btn.innerHTML = '<span class="fav-ref">' + row[1] + ' ' + row[2] + ':' + row[3] + '</span>';
      btn.onclick = function() { loadChapter(row[0], row[2], row[3]); toggleMenu(); };
      container.appendChild(btn);
    });
  } else {
    container.innerHTML = '<div style="padding: 1rem; text-align: center; color: var(--muted);">Nenhum favorito ainda.<br>Toque na estrela ⭐ de um versículo para salvar.</div>';
  }
}

function restoreReadingProgress() {
  var res = db.exec("SELECT livro_id, capitulo, versiculo FROM progresso WHERE id = 1");
  if (res[0]) loadChapter(res[0].values[0][0], res[0].values[0][1], res[0].values[0][2]);
}

function loadChapter(livroId, capitulo, restoreVerse) {
  stopAudio();
  var bRes = db.exec("SELECT id, nome_pt, nome_en, caps FROM livros WHERE id = " + livroId);
  if (!bRes[0]) return;
  
  currentBook = { id: bRes[0].values[0][0], nome_pt: bRes[0].values[0][1], nome_en: bRes[0].values[0][2], caps: bRes[0].values[0][3] };
  currentChapter = capitulo;
  
  document.getElementById('title').innerText = currentBook.nome_pt + ' ' + currentChapter;
  document.getElementById('subtitle').innerHTML = '<em>' + currentBook.nome_en + '</em>';
  document.getElementById('loc').innerText = currentBook.nome_pt + ' ' + currentChapter;
  
  var sel = document.getElementById('chapterSelect');
  sel.innerHTML = '';
  for (var i = 1; i <= currentBook.caps; i++) {
    var opt = document.createElement('option');
    opt.value = i; opt.innerText = 'Cap. ' + i;
    if (i === currentChapter) opt.selected = true;
    sel.appendChild(opt);
  }
  
  document.getElementById('prevCapBtn').disabled = (currentChapter === 1);
  document.getElementById('nextCapBtn').disabled = (currentChapter === currentBook.caps);
  
  var vRes = db.exec("SELECT numero, texto_en, texto_pt FROM versiculos WHERE livro_id = " + livroId + " AND capitulo = " + capitulo + " ORDER BY numero");
  currentVerses = [];
  if (vRes[0]) {
    vRes[0].values.forEach(function(row) { currentVerses.push({ numero: row[0], en: row[1], pt: row[2] }); });
  }
  
  var container = document.getElementById('verses');
  container.innerHTML = '';
  
  if (currentVerses.length === 0) {
    container.innerHTML = '<div style="text-align:center; color:var(--muted); margin-top:2rem; padding: 2rem; border: 1px dashed var(--border); border-radius: 10px;">Nenhum versículo baixado.<br><br>Use os botões acima para baixar da internet.</div>';
  } else {
    currentVerses.forEach(function(v) {
      var div = document.createElement('div');
      div.className = 'verse';
      div.id = 'verse-' + v.numero;
      div.onclick = function(e) { if(e.target.tagName !== 'BUTTON') startNarrationFrom(v.numero); };
      var isFav = checkFav(currentBook.id, currentChapter, v.numero);
      div.innerHTML = 
        '<button class="fav-btn ' + (isFav ? 'is-fav' : '') + '" onclick="toggleFav(this, ' + v.numero + ')">★</button>' +
        '<div><span class="verse-num">' + v.numero + '</span>' +
        '<div style="display:inline-block; width:calc(100% - 45px); vertical-align:top;">' +
        '<div class="verse-en"><span class="lang-tag">EN</span>' + v.en + '</div>' +
        '<div class="verse-pt"><span class="lang-tag">PT</span>' + v.pt + '</div>' +
        '</div></div>';
      container.appendChild(div);
    });
  }
  renderBooksList();
  saveProgress(restoreVerse || 1);
  
  if (restoreVerse && restoreVerse > 1) {
    setTimeout(function() {
      var el = document.getElementById('verse-' + restoreVerse);
      if (el) { el.classList.add('active'); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    }, 300);
  } else {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function changeChapterSelect(cap) {
  var c = parseInt(cap);
  if (c >= 1 && c <= currentBook.caps) {
    loadChapter(currentBook.id, c, 1);
  }
}
function saveProgress(verseNum) {
  if (!currentBook) return;
  db.run("UPDATE progresso SET livro_id = ?, capitulo = ?, versiculo = ? WHERE id = 1", [currentBook.id, currentChapter, verseNum]);
  saveDB();
}

async function fetchChapterData(bookEn, cap) {
  var attempt = 0;
  while (attempt < 3) {
    try {
      var resEn = await fetch('https://bible-api.com/' + encodeURIComponent(bookEn) + ' ' + cap + '?translation=kjv');
      var dataEn = await resEn.json();
      var resPt = await fetch('https://bible-api.com/' + encodeURIComponent(bookEn) + ' ' + cap + '?translation=almeida');
      var dataPt = await resPt.json();
      if (dataEn.verses && dataPt.verses) return { en: dataEn.verses, pt: dataPt.verses };
    } catch(e) {}
    attempt++;
    await new Promise(function(r) { setTimeout(r, 2000); });
  }
  return null;
}

async function downloadCurrentChapter() {
  if (!navigator.onLine) { showToast('Sem conexão à internet.'); return; }
  var btn = document.getElementById('dlChapterBtn');
  var oldText = btn.innerText;
  btn.innerText = 'Baixando...'; btn.disabled = true;
  
  try {
    var data = await fetchChapterData(currentBook.nome_en, currentChapter);
    if (data) {
      db.run("DELETE FROM versiculos WHERE livro_id = ? AND capitulo = ?", [currentBook.id, currentChapter]);
      var stmt = db.prepare("INSERT INTO versiculos VALUES (?, ?, ?, ?, ?)");
      for(var i=0; i<data.en.length; i++) stmt.run([currentBook.id, currentChapter, data.en[i].verse, data.en[i].text.trim(), data.pt[i].text.trim()]);
      stmt.free(); saveDB();
      loadChapter(currentBook.id, currentChapter, 1);
      showToast('Capítulo salvo offline!');
    } else {
      showToast('Erro na API. Tente novamente.');
    }
  } catch(e) { showToast('Erro ao baixar.'); } 
  finally { btn.innerText = oldText; btn.disabled = false; }
}

async function downloadWholeBook() {
  if (!navigator.onLine) { showToast('Sem conexão à internet.'); return; }
  var total = currentBook.caps;
  document.getElementById('downloadModal').classList.add('on');
  document.getElementById('dlProgressFill').style.width = '0%';
  var successCount = 0;
  
  for (var c = 1; c <= total; c++) {
    document.getElementById('dlProgressText').innerText = 'Baixando capítulo ' + c + ' de ' + total + '...';
    document.getElementById('dlProgressFill').style.width = ((c/total)*100) + '%';
    
    var data = await fetchChapterData(currentBook.nome_en, c);
    if (data) {
      db.run("DELETE FROM versiculos WHERE livro_id = ? AND capitulo = ?", [currentBook.id, c]);
      var stmt = db.prepare("INSERT INTO versiculos VALUES (?, ?, ?, ?, ?)");
      for(var i=0; i<data.en.length; i++) stmt.run([currentBook.id, c, data.en[i].verse, data.en[i].text.trim(), data.pt[i].text.trim()]);
      stmt.free();
      successCount++;
    }
    // 1.5s de pausa para não bloquear a API
    await new Promise(function(r) { setTimeout(r, 1500); });
  }
  
  saveDB();
  document.getElementById('downloadModal').classList.remove('on');
  loadChapter(currentBook.id, currentChapter, 1);
  showToast(successCount + ' capítulos baixados!');
}

function doSearch() {
  var q = document.getElementById('searchInput').value.trim().toLowerCase();
  var resDiv = document.getElementById('searchResults');
  if (q.length < 3) { resDiv.innerHTML = '<p style="padding:1rem;color:var(--muted);font-size:0.8rem;">Digite pelo menos 3 letras...</p>'; return; }
  
  var query = "SELECT livro_id, capitulo, numero, texto_pt FROM versiculos WHERE LOWER(texto_pt) LIKE '%" + q + "%' OR LOWER(texto_en) LIKE '%" + q + "%' LIMIT 50";
  var res = db.exec(query);
  
  resDiv.innerHTML = '';
  if (res[0] && res[0].values.length > 0) {
    res[0].values.forEach(function(row) {
      var bRes = db.exec("SELECT nome_pt FROM livros WHERE id = " + row[0]);
      var bName = bRes[0] ? bRes[0].values[0][0] : 'Livro';
      var div = document.createElement('div');
      div.className = 'search-result';
      div.innerHTML = '<span class="search-ref">' + bName + ' ' + row[1] + ':' + row[2] + '</span>' + row[3].substring(0, 70) + '...';
      div.onclick = function() { loadChapter(row[0], row[1], row[2]); toggleMenu(); };
      resDiv.appendChild(div);
    });
  } else {
    resDiv.innerHTML = '<p style="padding:1rem;color:var(--muted);font-size:0.8rem;">Nenhum resultado. (Lembre-se: a busca só acha textos que já foram baixados).</p>';
  }
}

function checkFav(livro, cap, ver) {
  var res = db.exec("SELECT id FROM favoritos WHERE livro_id = " + livro + " AND capitulo = " + cap + " AND versiculo = " + ver);
  return res[0] ? true : false;
}
function toggleFav(btn, ver) {
  var isFav = btn.classList.contains('is-fav');
  if (isFav) {
    db.run("DELETE FROM favoritos WHERE livro_id = ? AND capitulo = ? AND versiculo = ?", [currentBook.id, currentChapter, ver]);
    btn.classList.remove('is-fav');
  } else {
    db.run("INSERT INTO favoritos (livro_id, capitulo, versiculo) VALUES (?, ?, ?)", [currentBook.id, currentChapter, ver]);
    btn.classList.add('is-fav'); showToast('Favoritado!');
  }
  saveDB();
}

function toggleTheme() {
  state.theme = state.theme === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', state.theme);
  document.getElementById('themeBtn').innerText = state.theme === 'dark' ? '🌙' : '☀️';
  saveSettings();
}

function clearAllDownloads() {
  if (confirm("Tem certeza que deseja apagar TODOS os capítulos baixados, favoritos e progresso? O app voltará ao estado inicial.")) {
    if (idbStore) idbStore.close();
    var req = indexedDB.deleteDatabase("BibliaDB");
    req.onsuccess = function() {
      showToast("Dados limpos! Reiniciando...");
      setTimeout(function() { location.reload(); }, 1500);
    };
    req.onerror = function() {
      showToast("Erro ao limpar. Feche e abra o app.");
    };
  }
}

function loadVoices() {
  if (!('speechSynthesis' in window)) return;
  availableVoices = speechSynthesis.getVoices();
  var selEN = document.getElementById('voiceEN');
  var selPT = document.getElementById('voicePT');
  selEN.innerHTML = '<option value="">Automática</option>'; selPT.innerHTML = '<option value="">Automática</option>';
  availableVoices.forEach(function(v) {
    if (v.lang.toLowerCase().indexOf('en') === 0) selEN.innerHTML += '<option value="' + v.voiceURI + '">' + v.name + '</option>';
    if (v.lang.toLowerCase().indexOf('pt') === 0) selPT.innerHTML += '<option value="' + v.voiceURI + '">' + v.name + '</option>';
  });
  if (state.voiceEN) selEN.value = state.voiceEN;
  if (state.voicePT) selPT.value = state.voicePT;
}
if ('speechSynthesis' in window) speechSynthesis.onvoiceschanged = loadVoices;

function getVoice(lang, uri) {
  if (uri) { for (var i=0; i<availableVoices.length; i++) if (availableVoices[i].voiceURI === uri) return availableVoices[i]; }
  for (var j=0; j<availableVoices.length; j++) if (availableVoices[j].lang.toLowerCase().indexOf(lang) === 0) return availableVoices[j];
  return null;
}
function speak(text, lang, uri, callback) {
  if (!isPlaying) return;
  var utt = new SpeechSynthesisUtterance(text);
  utt.lang = lang === 'en' ? 'en-US' : 'pt-BR'; utt.rate = state.rate;
  var v = getVoice(lang, uri); if (v) utt.voice = v;
  utt.onend = callback; utt.onerror = callback;
  speechSynthesis.speak(utt);
}
function togglePlay() { if (isPlaying) stopAudio(); else startNarrationFrom(currentPlayingVerse || 1); }

function startNarrationFrom(num) {
  if (currentVerses.length === 0) { showToast('Baixe o capítulo primeiro.'); return; }
  stopAudio(); isPlaying = true; currentPlayingVerse = num;
  document.getElementById('playBtn').classList.add('active');
  document.getElementById('audioBar').classList.add('on');
  document.getElementById('pauseBtn').innerText = '⏸';
  playChain(num);
}

function playChain(num) {
  if (!isPlaying) return;
  if (num > currentVerses.length) {
    if (currentChapter < currentBook.caps) {
      var nextCap = currentChapter + 1;
      var check = db.exec("SELECT numero FROM versiculos WHERE livro_id = " + currentBook.id + " AND capitulo = " + nextCap + " LIMIT 1");
      if (check[0]) {
        loadChapter(currentBook.id, nextCap, 1);
        setTimeout(function() {
          isPlaying = true;
          document.getElementById('playBtn').classList.add('active');
          document.getElementById('audioBar').classList.add('on');
          playChain(1);
        }, 500);
        return;
      }
    }
    stopAudio(); showToast('Fim do áudio disponível.'); return;
  }
  
  var v = currentVerses[num - 1];
  currentPlayingVerse = num; saveProgress(num); highlightVerse(num);
  document.getElementById('audioInfo').innerText = currentBook.nome_pt + ' ' + currentChapter + ':' + num;
  
  var mode = state.audioMode;
  if (mode === 'en') {
    speak(v.en, 'en', state.voiceEN, function() { if (isPlaying) setTimeout(function() { playChain(num + 1); }, 300); });
  } else if (mode === 'pt') {
    speak(v.pt, 'pt', state.voicePT, function() { if (isPlaying) setTimeout(function() { playChain(num + 1); }, 300); });
  } else {
    speak(v.en, 'en', state.voiceEN, function() {
      if (!isPlaying) return;
      setTimeout(function() {
        speak(v.pt, 'pt', state.voicePT, function() { if (isPlaying) setTimeout(function() { playChain(num + 1); }, 300); });
      }, 100);
    });
  }
}

function stopAudio() {
  isPlaying = false; speechSynthesis.cancel(); clearHighlights();
  document.getElementById('playBtn').classList.remove('active');
  document.getElementById('audioBar').classList.remove('on');
}
function highlightVerse(num) {
  clearHighlights();
  var el = document.getElementById('verse-' + num);
  if (el) { el.classList.add('active'); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
}
function clearHighlights() {
  var els = document.querySelectorAll('.verse');
  for (var i=0; i<els.length; i++) els[i].classList.remove('active');
}

function openSettings() { document.getElementById('settingsModal').classList.add('on'); }
function closeSettings() { document.getElementById('settingsModal').classList.remove('on'); }
function showToast(msg) {
  var t = document.getElementById('toast');
  t.innerText = msg; t.classList.add('on');
  clearTimeout(toastTimer); toastTimer = setTimeout(function() { t.classList.remove('on'); }, 3000);
}
function loadSettings() {
  var s = localStorage.getItem('biblia_settings_v6');
  if (s) {
    state = JSON.parse(s);
    document.documentElement.style.setProperty('--fs', state.fontSize + 'px');
    document.documentElement.setAttribute('data-theme', state.theme || 'dark');
    document.getElementById('themeBtn').innerText = state.theme === 'dark' ? '🌙' : '☀️';
    document.getElementById('rateInput').value = state.rate; document.getElementById('rateVal').innerText = state.rate.toFixed(1);
    document.getElementById('fontInput').value = state.fontSize; document.getElementById('fontVal').innerText = state.fontSize;
    document.getElementById('audioMode').value = state.audioMode || 'both';
  }
}
function saveSettings() { localStorage.setItem('biblia_settings_v6', JSON.stringify(state)); }

document.getElementById('voiceEN').onchange = function(e) { state.voiceEN = e.target.value; saveSettings(); };
document.getElementById('voicePT').onchange = function(e) { state.voicePT = e.target.value; saveSettings(); };
document.getElementById('rateInput').oninput = function(e) { state.rate = parseFloat(e.target.value); document.getElementById('rateVal').innerText = state.rate.toFixed(1); saveSettings(); };
document.getElementById('fontInput').oninput = function(e) { state.fontSize = parseInt(e.target.value); document.documentElement.style.setProperty('--fs', state.fontSize + 'px'); document.getElementById('fontVal').innerText = state.fontSize; saveSettings(); };
document.getElementById('audioMode').onchange = function(e) { state.audioMode = e.target.value; saveSettings(); };

initApp();
</script>
